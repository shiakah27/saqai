# Copy this file to `.env` (repo root, for docker compose) and to `backend/.env`. Never commit `.env`.

# ---------- PostgreSQL ----------
POSTGRES_USER=saqai
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=saqai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://saqai:change_me_locally@localhost:5432/saqai

# ---------- Backend ----------
NODE_ENV=development
PORT=3000
# Both ESP32 boards send this in the `x-api-key` header. Use a long random string.
DEVICE_API_KEY=replace_with_a_long_random_string
# Admin endpoints (zone calibration, clearing an ERROR) use `x-admin-key`. Defaults to DEVICE_API_KEY.
ADMIN_API_KEY=
CORS_ORIGIN=*

# ---------- AI service ----------
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=3000

# ---------- Real-time sensors ----------
WEATHER_STORE_SECONDS=60         # live every ~2 s; one weather row stored per minute
SOIL_STORE_SECONDS=10
SENSOR_STALE_SECONDS=10          # ESP32 #2 holds every zone if the sensor node is silent this long

# ---------- Timing & safety ----------
PREDICTION_INTERVAL_MINUTES=30
RAIN_COOLDOWN_MINUTES=5          # prototype: 5 min so judges see the full cycle; field: 120+
MANUAL_TTL_SECONDS=60            # a manual test run not picked up within this time expires
MAX_PUMP_ON_SECONDS=60           # sent to ESP32 #2; it can only be LOWER than the board's own 60 s limit
PUMP_FLOW_LPM=2.0                # measure it: docs/calibration.md

# ---------- Decision engine on ESP32 #2 (sent on every poll — no reflashing needed) ----------
MAX_DEFER_HOURS=3                # = forecast horizon
DEFER_HYSTERESIS=0.03             # defer starts at p ≥ threshold (0.08) and ends below threshold − 0.03
SOAK_SECONDS=120                 # wait after a pulse for water to reach the sensor
MAX_PULSES=3                     # pulses in a row without reaching target …
PULSE_LOCK_MINUTES=30            # … then that zone pauses (stuck or misplaced sensor)
FOLLOWUP_MAX_SECONDS=10
DAILY_MAX_SECONDS_PER_ZONE=300
# Water less (up to this fraction) when rain is likely but below the threshold. 0 = OFF (not validated on data).
FORECAST_TRIM_MAX=0

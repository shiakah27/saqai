{
  "name": "saqai-backend",
  "version": "0.1.0",
  "description": "SAQAI smart irrigation backend (Node.js + Express + PostgreSQL)",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "check:env": "node scripts/check-env.js",
    "check:db": "node scripts/check-db.js",
    "db:migrate": "node src/database/migrate.js",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "e2e": "node tests/e2e/rain-override.e2e.js",
    "doctor": "node ../tools/doctor.js",
    "test:firmware": "g++ -std=c++17 -Wall -Wextra -Werror -I../esp32/actuator_node ../esp32/tests/test_decision.cpp -o ../esp32/tests/test_decision && ../esp32/tests/test_decision"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ]
  }
}
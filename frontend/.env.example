# Copy to `.env.local`.
#
# VITE_DATA_SOURCE=demo  → replays real Riyadh rain events (no backend needed)
# VITE_DATA_SOURCE=live  → polls the Node backend (/api/status, /api/history)
VITE_DATA_SOURCE=demo   # `npm run dev` default. `npm run build` (served by the backend) uses live; add #demo to the URL to force the replay.

# Only needed if the backend is NOT on the same host (in dev, /api is proxied to :3000).
VITE_API_URL=

# How often the dashboard polls the backend in live mode (ms).
VITE_POLL_MS=3000
